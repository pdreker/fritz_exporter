        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(fritz_wan_layer1_max_bitrate_bps{friendly_name=\"$device\",direction=\"tx\"} or fritz_wan_max_bitrate_bps{friendly_name=\"$device\",direction=\"tx\"})",
          "refId": "B",
          "legendFormat": "up",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
