      }
    },
    {
      "type": "bargauge",
      "title": "WiFi networks",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fritz_wifi_associations_count{friendly_name=\"$device\"} * on (serial, wifi_index) group_left (ssid) fritz_wifi_info{friendly_name=\"$device\"}",
          "refId": "A",
          "legendFormat": "{{ssid}} ({{wifi_name}})",
